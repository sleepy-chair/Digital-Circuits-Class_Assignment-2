  <vhdl appearance="logisim_evolution" name="And_Or">--library and package
LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.std_logic_arith.all;
USE ieee.std_logic_unsigned.all;


--entity (input&amp;output)
ENTITY And_Or IS
	PORT (
		a,b,c,d		:IN  std_logic;                    
		out1,out2		:OUT std_logic
	);
END And_Or;

--architecture
ARCHITECTURE bhv OF And_Or IS
BEGIN
	
	out1 &lt;= a and b and c and d;
	out2 &lt;= a or b or c or d;
END ARCHITECTURE bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="mux8_1">--library and package
LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.std_logic_arith.all;
USE ieee.std_logic_unsigned.all;


--entity (input&amp;output)
ENTITY mux8_1 IS
	PORT (
		a,b,c,d,e,f,g,i	:IN  std_logic;       
		ch				:IN	std_logic_vector(2 downto 0);
		data				:OUT std_logic
	);
END mux8_1;

--architecture
ARCHITECTURE bhv OF mux8_1 IS
BEGIN
	process(a,b,c,d,e,f,g,i,ch)
	begin
		case ch is
			when "000" =&gt; data &lt;= a;
			when "001" =&gt; data &lt;= b;
			when "010" =&gt; data &lt;= c;
			when "011" =&gt; data &lt;= d;
			when "100" =&gt; data &lt;= e;
			when "101" =&gt; data &lt;= f;
			when "110" =&gt; data &lt;= g;
			when "111" =&gt; data &lt;= i;
			when others =&gt; data &lt;= '0';
		end case;
	end process;
END ARCHITECTURE bhv;
</vhdl>
  <vhdl appearance="logisim_evolution" name="display_letters">--library and package
LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.std_logic_arith.all;
USE ieee.std_logic_unsigned.all;

--entity (input&amp;output)
ENTITY display_letters IS
	PORT (
		en			:IN  std_logic;       
		data			:IN	std_logic_vector(2 downto 0);
		display		:OUT std_logic_vector(7 downto 0)
	);
END display_letters;

--architecture
ARCHITECTURE bhv OF display_letters IS
BEGIN
	process(en,data)
	begin
		if en='0' then
			display &lt;= "ZZZZZZZZ";
		else
			case data is
				when "000" =&gt; display &lt;= "11101111";
				when "001" =&gt; display &lt;= "00111111";
				when "010" =&gt; display &lt;= "00011011";
				when "011" =&gt; display &lt;= "01111011";
				when "100" =&gt; display &lt;= "10001111";
				when "101" =&gt; display &lt;= "11110111";
				when others =&gt; display &lt;= "00000000";
			end case;
		end if;
	end process;
END ARCHITECTURE bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="vote25">--library and package
LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.std_logic_arith.all;
USE ieee.std_logic_unsigned.all;

--entity (input&amp;output)
ENTITY vote25 IS
	PORT (
		vt			:IN	std_logic_vector(25 downto 1);
		result		:OUT std_logic
	);
END vote25;

--architecture
ARCHITECTURE bhv OF vote25 IS
BEGIN
	process(vt)
	variable sum:integer range 0 to 25;
	begin
		sum:=0;
		for i in 1 to 25 loop
			if (vt(i)='1') then
				sum:=sum+1;
			end if;
		end loop;
		if sum &gt;= 13 then
			result &lt;= '1';
		else
			result &lt;= '0';
		end if;
	end process;
END ARCHITECTURE bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="problem5">--library and package
LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.std_logic_arith.all;
USE ieee.std_logic_unsigned.all;

--entity (input&amp;output)
ENTITY problem5 IS
	PORT (
		en			:IN  std_logic;       
		vt			:IN	std_logic_vector(14 downto 0);
		display		:OUT std_logic_vector(7 downto 0)
	);
END problem5;

--architecture
ARCHITECTURE bhv OF problem5 IS
BEGIN
	process(en,vt)
	variable sum:integer range 0 to 15;
	begin
		if en='0' then
			display &lt;= "ZZZZZZZZ";
		else
			sum:=0;
			for i in 0 to 14 loop
				if (vt(i)='1') then
					sum:=sum+1;
				end if;
			end loop;
			case sum is
				when 0 =&gt; display &lt;= "11111100";
				when 1 =&gt; display &lt;= "01100000";
				when 2 =&gt; display &lt;= "11011010";
				when 3 =&gt; display &lt;= "11110010";
				when 4 =&gt; display &lt;= "01100110";
				when 5 =&gt; display &lt;= "10110110";
				when 6 =&gt; display &lt;= "10111110";
				when 7 =&gt; display &lt;= "11100100";
				when 8 =&gt; display &lt;= "11111110";
				when 9 =&gt; display &lt;= "11110110";
				when 10 =&gt; display &lt;= "11101111";
				when 11 =&gt; display &lt;= "00111111";
				when 12 =&gt; display &lt;= "00011011";
				when 13 =&gt; display &lt;= "01111011";
				when 14 =&gt; display &lt;= "10011111";
				when 15 =&gt; display &lt;= "10001111";
				when others =&gt; display &lt;= "00000000";
			end case;
		end if;
	end process;
END ARCHITECTURE bhv;</vhdl>
